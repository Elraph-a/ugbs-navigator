# Copy to .env and fill in. .env is gitignored and must never be committed.

# gemini | groq | ollama | extractive
# extractive needs no key and exercises the whole pipeline.
LLM_PROVIDER=extractive

# Required only when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required only when LLM_PROVIDER=groq. Free key: https://console.groq.com/keys
# Confirm GROQ_MODEL with: python tools/check_provider.py --provider groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Required only when LLM_PROVIDER=ollama.
# Measured at 1-3 minutes per answer on the demo laptop - use only on stronger hardware.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=6
CONFIDENCE_THRESHOLD=0.42

# Privacy: how long logged enquiries are kept
RETENTION_DAYS=180

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Deployment only (tools/deploy_backend.py). A Hugging Face token with write access.
HF_TOKEN=

# Deployed API only: extra frontend origins allowed to call it, comma-separated.
CORS_ORIGINS=
# Requests per minute, per visitor and in total, before the API answers 429.
RATE_LIMIT_PER_VISITOR=10
RATE_LIMIT_TOTAL=40
