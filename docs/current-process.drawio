<mxfile host="app.diagrams.net">
  <diagram name="As-is process: requesting an official transcript">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="start" value="Student needs an official transcript" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#1c1d1f;strokeColor=#1c1d1f;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100.0" y="100" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="d1" value="Postgraduate&lt;br&gt;student?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="190" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="sgs" value="Email the School of Graduate Studies&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;sgstranscript@ug.edu.gh — a different office entirely&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ec;strokeColor=#7ba488;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="d2" value="Graduated&lt;br&gt;before 1996?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="340" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="pre96a" value="Pay at the Cash Office" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ec;strokeColor=#7ba488;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="350" width="350" height="56" as="geometry"/></mxCell>
        <mxCell id="pre96b" value="Submit the receipt at Room D2, AAD&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Ready for collection in about two weeks&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ec;strokeColor=#7ba488;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="418" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="d3" value="Needed the&lt;br&gt;same day?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="500" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="exp1" value="Submit the request before 11:00 AM&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Express is not available on the STS portal&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="500" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="exp2" value="Pay at the Cash Office" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ec;strokeColor=#7ba488;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="582" width="350" height="56" as="geometry"/></mxCell>
        <mxCell id="exp3" value="Submit the receipt at Room D2, AAD&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Typically ready within 24 hours — GH₵60&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ec;strokeColor=#7ba488;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="646" width="350" height="80" as="geometry"/></mxCell>
        <mxCell id="s1" value="Check your record on the MIS portal&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;mis.ug.edu.gh&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef1f8;strokeColor=#8a9ac0;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100.0" y="660" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="s2" value="Submit the request and pay on the STS portal&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;sts.ug.edu.gh&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef1f8;strokeColor=#8a9ac0;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100.0" y="748" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="s3" value="Track the request on the same portal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eef1f8;strokeColor=#8a9ac0;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100.0" y="836" width="300" height="72" as="geometry"/></mxCell>
        <mxCell id="d4" value="Collected by&lt;br&gt;someone else?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="920" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="proxy" value="Bring a consent letter, the owner's ID and the proxy's ID&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Only discoverable at the collection desk&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="930" width="350" height="92" as="geometry"/></mxCell>
        <mxCell id="done" value="Transcript issued" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#e8e8e5;strokeColor=#8f8f8a;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100.0" y="1080" width="300" height="58" as="geometry"/></mxCell>
        <mxCell id="p1" value="1. Four different routes, and the student must know which one applies before starting. Nothing asks them." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="96" width="360" height="124" as="geometry"/></mxCell>
        <mxCell id="p2" value="2. Three separate systems: MIS Web for records, the STS portal for the request and payment, the Cash Office for express and pre-1996 routes." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="248" width="360" height="124" as="geometry"/></mxCell>
        <mxCell id="p3" value="3. Two offices own “transcripts”. Postgraduate requests go to the School of Graduate Studies, which is one line on the AAD's page." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="400" width="360" height="124" as="geometry"/></mxCell>
        <mxCell id="p4" value="4. Express eligibility is a time-of-day rule — before 11:00 AM — visible only to a student who reads the whole page first." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="552" width="360" height="124" as="geometry"/></mxCell>
        <mxCell id="p5" value="5. Six fee variants by delivery mode: GH₵30 pick-up, GH₵85 by post, US$55 courier, US$10 digital, GH₵60 express, GH₵25 per extra copy." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="704" width="360" height="124" as="geometry"/></mxCell>
        <mxCell id="p6" value="6. Proxy rules surface at the collection desk. A student who did not read ahead makes a second trip." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="856" width="360" height="124" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d1" target="sgs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d2" target="pre96a"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="pre96a" target="pre96b"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d3" target="exp1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="exp1" target="exp2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="exp2" target="exp3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d3" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="s3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d4" target="proxy"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="d4" target="done"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
