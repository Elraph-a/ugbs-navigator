<mxfile host="app.diagrams.net">
  <diagram name="System architecture: UGBS Service Navigator">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="g_user" value="Users" style="rounded=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c9c9c4;fontColor=#6c6c66;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="1460" height="100" as="geometry"/></mxCell>
        <mxCell id="g_ui" value="Interface" style="rounded=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c9c9c4;fontColor=#6c6c66;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="214" width="1460" height="128" as="geometry"/></mxCell>
        <mxCell id="g_ai" value="AI system — one conversational turn" style="rounded=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c9c9c4;fontColor=#6c6c66;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="700" height="770" as="geometry"/></mxCell>
        <mxCell id="g_know" value="Knowledge and data" style="rounded=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c9c9c4;fontColor=#6c6c66;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="390" height="400" as="geometry"/></mxCell>
        <mxCell id="g_act" value="Decision and action" style="rounded=1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#c9c9c4;fontColor=#6c6c66;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="940" width="320" height="280" as="geometry"/></mxCell>
        <mxCell id="student" value="UGBS student" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#1c1d1f;strokeColor=#1c1d1f;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="124" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="admin" value="UGBS administrative staff" style="rounded=1;arcSize=60;whiteSpace=wrap;html=1;fillColor=#1c1d1f;strokeColor=#1c1d1f;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="124" width="340" height="56" as="geometry"/></mxCell>
        <mxCell id="chat" value="Chat interface&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Streamed reply, citations, office card, steps&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="244" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="dash" value="Administrative dashboard&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Password protected. Demand, busiest hours, gap register, forecast&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="244" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="api" value="FastAPI service&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;/chat/stream · /analytics · /services&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="390" width="660" height="58" as="geometry"/></mxCell>
        <mxCell id="triage" value="1. Triage&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;In scope, small talk or off topic — and rewrite a follow-up into a full question&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="466" width="660" height="80" as="geometry"/></mxCell>
        <mxCell id="router" value="2. Route&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Question to service and office — a table lookup, never a model&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="562" width="660" height="80" as="geometry"/></mxCell>
        <mxCell id="retrieve" value="3. Retrieve&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Embeddings and keywords over the document index, fused into one ranking&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="658" width="660" height="80" as="geometry"/></mxCell>
        <mxCell id="gate" value="4. Confidence gate&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Too weak a match: the model is not called at all&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="754" width="660" height="100" as="geometry"/></mxCell>
        <mxCell id="compose" value="5. Compose the reply&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;The model phrases an answer from the retrieved text and the verified procedure. It supplies no facts of its own.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fdf3df;strokeColor=#d9a934;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="882" width="420" height="124" as="geometry"/></mxCell>
        <mxCell id="refuse" value="5b. Decline&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Name what is not covered and which office to ask&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fcecea;strokeColor=#c96a5c;fontColor=#7d2f24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="882" width="220" height="124" as="geometry"/></mxCell>
        <mxCell id="redact" value="6. Redact, then log&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Names, IDs, phone numbers and emails removed before anything is written&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f4f4f2;strokeColor=#b9b9b4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="1032" width="660" height="76" as="geometry"/></mxCell>
        <mxCell id="structured" value="Verified procedure catalogue&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;services.json and offices.json — rooms, fees, contacts and steps, transcribed by hand from the published sources&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2effa;strokeColor=#9b8ec4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="350" height="160" as="geometry"/></mxCell>
        <mxCell id="corpus" value="Document index&lt;br&gt;&lt;font style='font-size:10px' color='#6c6c66'&gt;Published UG and UGBS documents, chunked and embedded, each carrying its source, date and real-or-synthetic label&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2effa;strokeColor=#9b8ec4;fontColor=#1c1d1f;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="log" value="Enquiry log&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;Redacted, with a retention limit&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f2effa;strokeColor=#9b8ec4;fontColor=#1c1d1f;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1170" y="980" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="insight" value="Analytics&lt;br&gt;&lt;font style='font-size:11px' color='#6c6c66'&gt;What to publish next, where to add staff&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#eaf2ec;strokeColor=#7ba488;fontColor=#1c1d1f;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="1120" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7d7d78;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#5c5c57;" edge="1" parent="1" source="student" target="chat"><mxGeometry relative="1" as="geometry"/></mxCell>
