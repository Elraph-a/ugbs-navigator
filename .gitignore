# Secrets — never commit
.env

# Disposable
.tmp/
data/chroma/
*.db
*.sqlite3

# Raw downloads: large, and redistributable only from their source
data/raw/*
!data/raw/SOURCES.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Node
node_modules/
.next/
out/
npm-debug.log*

# Report, slides and planning material stay out of the repository
*.docx
*.pptx
*.pdf
docs/report*
docs/slides*

# Agent instructions and design explorations are ours, not the repository's
CLAUDE.md
.impeccable/

# Evaluation write-ups are regenerated by tools/run_evaluation.py; the older
# ones are working history rather than something needed to run the system
docs/evaluation-*.md

# OS
Thumbs.db
.DS_Store

# Embedding model downloaded on first use when EMBEDDING_CACHE points here
.cache/
